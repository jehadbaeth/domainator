# Copy this file to .env (project root or backend/) and fill in what you have.
# A registrar switches on automatically when all its variables are set. Leave the rest empty.
# .env is gitignored. Never commit real keys.
#
# Porkbun, OVHcloud, INWX and Vercel need nothing and are always on.

# ---------------------------------------------------------------------------
# Namecheap  https://ap.www.namecheap.com/settings/tools/apiaccess/
# Needs API access switched on (account must have 20+ domains, $50+ balance, or $50+ spent in 2 years)
# and your public IPv4 whitelisted on that page. Find it with: curl -4 ifconfig.me
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=
NAMECHEAP_CLIENT_IP=
NAMECHEAP_SANDBOX=false

# NameSilo  https://www.namesilo.com/account/api-manager
NAMESILO_API_KEY=

# Dynadot  control panel > Tools > API
DYNADOT_API_KEY=

# Spaceship  https://www.spaceship.com/application/api-manager/  (scope: domains:read)
SPACESHIP_API_KEY=
SPACESHIP_API_SECRET=

# Name.com  https://www.name.com/account/settings/api
NAMECOM_USERNAME=
NAMECOM_API_TOKEN=
NAMECOM_SANDBOX=false

# Internet.bs  (set INTERNETBS_TEST=true to try the public test environment without an account)
INTERNETBS_API_KEY=
INTERNETBS_PASSWORD=
INTERNETBS_TEST=false

# AWS Route 53 Domains  IAM user with permission route53domains:ListPrices on "*"
ROUTE53_ACCESS_KEY_ID=
ROUTE53_SECRET_ACCESS_KEY=

# GoDaddy  Personal Access Token  https://developer.godaddy.com
GODADDY_TOKEN=

# Gandi  Personal Access Token  https://admin.gandi.net/organizations/account/pat
GANDI_TOKEN=

# Cloudflare  API token with Registrar permissions + your account id (dashboard URL)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Hostinger  hPanel > Profile > API
HOSTINGER_TOKEN=

# Openprovider  reseller account login
OPENPROVIDER_USERNAME=
OPENPROVIDER_PASSWORD=

# Vercel  optional, the price API currently answers without a token
VERCEL_TOKEN=
